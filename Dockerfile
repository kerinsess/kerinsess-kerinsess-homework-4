# ── Базовий образ ─────────────────────────────────────────────────────────
FROM python:3.12-slim

# ── Метадані ──────────────────────────────────────────────────────────────
LABEL description="Гіпотеза Колатца — паралельні обчислення"

# ── Змінні середовища (можна перевизначити через -e при docker run) ────────
ENV COLLATZ_N=10000000
ENV COLLATZ_THREADS=4

# ── Робоча директорія всередині контейнера ────────────────────────────────
WORKDIR /app

# ── Копіюємо вихідний код ─────────────────────────────────────────────────
COPY collatz.py .

# ── Точка входу ───────────────────────────────────────────────────────────
CMD ["python", "collatz.py"]
